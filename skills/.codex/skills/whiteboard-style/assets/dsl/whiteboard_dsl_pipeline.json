            { "type": "rect", "id": "model", "width": "fill-container", "height": 56, "text": "候选模型 v2.3", "fontSize": 13, "fillColor": "#FFFFFF", "borderColor": "#3370FF", "borderWidth": 1.5, "borderRadius": 8 },
            { "type": "rect", "id": "cases", "width": "fill-container", "height": 56, "text": "用例集 cases-v3", "fontSize": 13, "fillColor": "#FFFFFF", "borderColor": "#3370FF", "borderWidth": 1.5, "borderRadius": 8 }
